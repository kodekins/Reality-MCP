# Server
PORT=8080
# Comma-separated production origins. Leave unset for local development.
# CORS_ORIGINS=https://reality.example.com

# Supabase (server-side only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional live camera vision. Without it, Reality runs in deterministic demo mode.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional frontend override when the MCP API is deployed on another origin.
# VITE_MCP_URL=https://api.example.com/mcp
